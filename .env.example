# Optional. Nothing here is required: tests and the demo run offline by default.

# Real Redis (>= 6.2) for `npm run test:redis` and `npm run demo -- --backend redis`.
# Without it the demo uses the practice fake (mock) Redis and the real-Redis tests are skipped.
# REDIS_URL=redis://localhost:6379

# Demo output language: en | ko (after --lang, before LC_ALL / LC_MESSAGES / LANG).
# MCP_STREAMSTORE_LANG=en
